{
  "name": "wethefolks-rich-media-ads",
  "private": true,
  "version": "0.1.0",
  "description": "We The Folks take-home: Variant A (Gut Run game ad) and Variant B (fireplace ad).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "npm run build:a",
    "build:a": "vite build --mode variant-a && node tools/size-report.mjs variant-a-game",
    "preview": "vite preview",
    "measure:a": "node tools/measure.mjs variant-a-game",
    "compress:a": "node tools/compress.mjs variant-a-game",
    "size": "node tools/size-report.mjs",
    "hitboxes:a": "node tools/hitboxes.mjs variant-a-game",
    "test": "vitest run variant-a-game/test"
  },
  "dependencies": {
    "gsap": "3.15.0"
  },
  "devDependencies": {
    "lightningcss": "1.33.0",
    "sharp": "0.35.5",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0"
  }
}
